# Required at runtime. Generate a long random value for production.
SECRET_KEY=replace-with-a-long-random-secret

# Required for the SIGNIX Assistant chat and Gemini roof analysis.
# Create a Gemini API key, replace the placeholder, then restart the app.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Optional for the default SQLite web service. The postgres Compose profile
# supplies its own PostgreSQL URL automatically.
# DATABASE_URL=sqlite:////app/data/solar_app.db

# Optional: override the default external service endpoints.
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
PVGIS_URL=https://re.jrc.ec.europa.eu/api/v5_2/PVcalc
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse

# Stage 2 AI rooftop interpretation (uses the existing Gemini integration)
# The existing GEMINI_API_KEY above is also used by the rooftop analyzer.
# Optional: override the model used for rooftop image analysis.
GEMINI_ROOF_MODEL=gemini-3.6-flash

# Prototype reconstruction remains available without provider keys. Set false
# only when the deployment should require provider-backed rooftop data.
ROOFTOP_PROTOTYPE_FIXTURE=true
ROOFTOP_EXTERNAL_CACHE_DAYS=30

# Google Solar API — enables location-specific rooftop 3D reconstruction.
# Enable Solar API + billing in the same Google Cloud project.
GOOGLE_SOLAR_API_KEY=
# Optional fallback if the same key is already used for Maps.
GOOGLE_MAPS_API_KEY=